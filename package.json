{
  "name": "longform",
  "private": true,
  "version": "0.1.0",
  "description": "LongForm: one prompt -> a continuous 15-minute AI video stitched from short, style-locked clips.",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @longform/server dev",
    "dev:web": "pnpm --filter @longform/web dev",
    "migrate": "pnpm --filter @longform/server migrate"
  }
}
